---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="About | Antonio Bergas"
  company="About Antonio Bergas, Platform Engineer"
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="About"
        tagline="Thanks for stopping by. Read below to learn more about myself and my background."
      >
        <img
          width="1553"
          height="873"
          src="/assets/at-work.jpg"
          alt="Antonio Bergas at work with a colleague"
        />
      </Hero>

      <section>
        <div class="section-title">Background</div>
        <div class="content">
          <p>
            As a Platform Engineer, I build and run the CI/CD platform that
            engineering teams rely on to build, test and ship software.
          </p>
          <br />
          <p>
            Automation is what drives me. Ever since I started as a Full Stack
            Developer I've looked for ways to make processes faster and more
            effective, and DevOps culture turned out to fit the way I work
            perfectly.
          </p>
          <br />
          <p>
            What I work on: CI/CD pipelines, reusable GitHub Actions workflows,
            build infrastructure (agents and runners), DevSecOps, governance and
            developer experience.
          </p>
          <br />
          <p>
            Now that AI agents are starting to write and ship code, I'm focused
            on making agentic workflows as safe and repeatable as any other
            pipeline.
          </p>
          <br />
          <p>Happy to talk about platform engineering and automation.</p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <div>
            <p><strong>Web Development with Java</strong></p>
            <p>Oct 2016 - May 2017 · Palma de Mallorca</p>
            <p>
              Activities and groups: Desktop JAVA Applications, Web JEE
              Applications, MySQL, JavaScript, HTML5, CSS3
            </p>
            <p>
              Youth Employability Programme by Fundación Telefónica: intensive
              Java web development course with a final project in sector
              companies.
            </p>
          </div>
        </div>
      </section>
      <section>
        <h2 class="section-title">Skills</h2>
        <div class="content">
          <ul>
            <li><strong>CI/CD</strong></li>
            <li><strong>GitHub Actions</strong></li>
            <li><strong>Azure DevOps</strong></li>
            <li><strong>DevSecOps</strong></li>
            <li><strong>Docker</strong></li>
            <li><strong>Infrastructure as Code</strong></li>
            <li><strong>HashiCorp Ecosystem</strong></li>
            <li><strong>Linux</strong></li>
            <li><strong>Bash</strong></li>
            <li><strong>TypeScript</strong></li>
            <li><strong>React</strong></li>
            <li><strong>Node</strong></li>
          </ul>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
